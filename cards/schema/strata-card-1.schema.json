{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/qiuzan2001/strata-profile-studio/blob/main/cards/schema/strata-card-1.schema.json",
 "title": "Strata result card, version 1",
 "description": "One profile run of Strata on one PC. Made by `studio.py --card`. No prompts, host names, user names, paths, keys or config file.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "id",
  "name",
  "date",
  "studio",
  "strata",
  "os",
  "model",
  "pc",
  "decode",
  "prefill",
  "agent_turns",
  "settings",
  "tune",
  "noise",
  "run",
  "defaults"
 ],
 "properties": {
  "schema": {
   "const": "strata-card/1"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z2-7]{10}$"
  },
  "name": {
   "type": "string",
   "pattern": "^[A-Za-z0-9 _-]{0,12}$"
  },
  "date": {
   "type": "string",
   "pattern": "^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$"
  },
  "studio": {
   "type": "string",
   "maxLength": 20,
   "pattern": "^[0-9][0-9A-Za-z.+-]*$"
  },
  "strata": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "commit",
    "engine",
    "backend",
    "driver"
   ],
   "properties": {
    "version": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "commit": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 40,
     "pattern": "^[0-9a-f]*$"
    },
    "engine": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 20,
     "pattern": "^[0-9A-Za-z.+-]*$"
    },
    "backend": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 30,
     "pattern": "^[^/\\\\@<>`]*$"
    },
    "driver": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 30,
     "pattern": "^[^/\\\\@<>`]*$"
    }
   }
  },
  "os": {
   "type": "string",
   "maxLength": 40,
   "pattern": "^[^/\\\\@<>`]*$"
  },
  "model": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "quant",
    "context",
    "kv",
    "kv_resident"
   ],
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 60,
     "pattern": "^[^/\\\\@<>`]*$"
    },
    "quant": {
     "type": "string",
     "maxLength": 20,
     "pattern": "^[^/\\\\@<>`]*$"
    },
    "context": {
     "type": "integer",
     "minimum": 512,
     "maximum": 10000000
    },
    "kv": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 12,
     "pattern": "^[^/\\\\@<>`]*$"
    },
    "kv_resident": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 10000000
    }
   }
  },
  "pc": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "cpu",
    "ram",
    "pcie",
    "gpu",
    "limit"
   ],
   "properties": {
    "cpu": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "cores",
      "threads",
      "pool_workers",
      "expert_read_gbs"
     ],
     "properties": {
      "name": {
       "type": "string",
       "maxLength": 80,
       "pattern": "^[^/\\\\@<>`]*$"
      },
      "cores": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "maximum": 1024
      },
      "threads": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "maximum": 4096
      },
      "pool_workers": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 4096
      },
      "expert_read_gbs": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0.01,
       "maximum": 2000
      }
     }
    },
    "ram": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "gib"
     ],
     "properties": {
      "gib": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 1,
       "maximum": 8192
      }
     }
    },
    "pcie": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "gen",
      "width",
      "measured_gbs"
     ],
     "properties": {
      "gen": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "maximum": 7
      },
      "width": {
       "type": [
        "integer",
        "null"
       ],
       "enum": [
        1,
        2,
        4,
        8,
        16,
        null
       ]
      },
      "measured_gbs": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0.01,
       "maximum": 300
      }
     }
    },
    "gpu": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "vram_mib",
      "power_limit_w",
      "expert_cache_mib",
      "expert_slots"
     ],
     "properties": {
      "name": {
       "type": "string",
       "maxLength": 80,
       "pattern": "^[^/\\\\@<>`]*$"
      },
      "vram_mib": {
       "type": "integer",
       "minimum": 1024,
       "maximum": 1048576
      },
      "power_limit_w": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 1,
       "maximum": 3000
      },
      "expert_cache_mib": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 1048576
      },
      "expert_slots": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 10000000
      }
     }
    },
    "limit": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "gpu",
      "cpu",
      "pcie",
      null
     ]
    }
   }
  },
  "decode": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "context",
     "tps",
     "min",
     "max",
     "n",
     "floor",
     "floor_assumed",
     "hit_rate",
     "pcie_share",
     "ms_per_window",
     "tokens_per_window",
     "window_ms"
    ],
    "properties": {
     "kind": {
      "enum": [
       "chat",
       "long context",
       "agent turns"
      ]
     },
     "context": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
     },
     "tps": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
     },
     "min": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
     },
     "max": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
     },
     "floor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "floor_assumed": {
      "type": "boolean"
     },
     "hit_rate": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     },
     "pcie_share": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     },
     "ms_per_window": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 10000
     },
     "tokens_per_window": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0,
      "maximum": 64
     },
     "window_ms": {
      "anyOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "GPU",
         "CPU experts",
         "draft",
         "adapt wait",
         "other"
        ],
        "properties": {
         "GPU": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
         },
         "CPU experts": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
         },
         "draft": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
         },
         "adapt wait": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
         },
         "other": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
         }
        }
       },
       {
        "type": "null"
       }
      ]
     }
    }
   }
  },
  "prefill": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "label",
     "tokens",
     "tps",
     "floor",
     "floor_assumed",
     "read_s"
    ],
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[^/\\\\@<>`]*$"
     },
     "tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
     },
     "tps": {
      "type": "number",
      "minimum": 1,
      "maximum": 200000
     },
     "floor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "floor_assumed": {
      "type": "boolean"
     },
     "read_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
     }
    }
   }
  },
  "agent_turns": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "turn",
     "tps",
     "prompt_tokens"
    ],
    "properties": {
     "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
     },
     "tps": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
     },
     "prompt_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
     }
    }
   }
  },
  "settings": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "flag",
     "value",
     "default",
     "calibrated"
    ],
    "properties": {
     "flag": {
      "type": "string",
      "pattern": "^(--[a-z0-9-]{1,40}|STRATA_[A-Z0-9_]{1,40}|[a-z_]{1,40})$"
     },
     "value": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[^/\\\\@<>`]*$"
     },
     "default": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 60,
      "pattern": "^[^/\\\\@<>`]*$"
     },
     "calibrated": {
      "type": "boolean"
     }
    }
   }
  },
  "tune": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "calibration_tok_s",
      "minutes",
      "kept",
      "before_run"
     ],
     "properties": {
      "calibration_tok_s": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0.1,
       "maximum": 1000
      },
      "minutes": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0,
       "maximum": 1440
      },
      "kept": {
       "type": "string",
       "maxLength": 240,
       "pattern": "^[^/\\\\@<>`]*$"
      },
      "before_run": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "maximum": 100000
      }
     }
    }
   ]
  },
  "noise": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "pairs",
    "labels"
   ],
   "properties": {
    "pairs": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000
    },
    "labels": {
     "type": "array",
     "maxItems": 6,
     "items": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[^/\\\\@<>`]*$"
     }
    }
   }
  },
  "run": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 1,
   "maximum": 100000
  },
  "defaults": {
   "type": "boolean"
  }
 }
}
